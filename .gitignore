# Dependencies (npm workspaces install into the root node_modules)
node_modules/

# SQLite side files (api/.gitignore already ignores dev.db, .env, generated/, .output/ and .nitro/;
# web/.gitignore ignores dist/)
*.db-journal
*.db-wal
*.db-shm

# Logs and OS files
*.log
.DS_Store
Thumbs.db

# Playwright output
test-results/
playwright-report/
blob-report/

# Agentic QA platform run output (the workflows also keep it out of git)
/results/
